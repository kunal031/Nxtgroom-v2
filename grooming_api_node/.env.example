# Runtime
# Required: the API refuses to start when NODE_ENV is unset. Use production on
# a server (docker-compose.yml forces it) and development locally.
NODE_ENV=development
PORT=8000
PROCESS_ROLE=all
# Reverse proxies in front of the API. Lightsail with Nginx only: 1. Add one
# for each extra layer (Lightsail load balancer, Cloudflare).
TRUST_PROXY_HOPS=1
# Gemini jobs run at once by the background worker. 4 keeps reports on time
# during the 9 AM / 6 PM rush for ~1,000 instructors on the 2 GB plan.
EVALUATION_CONCURRENCY=4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
CRON_SECRET=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
# One-off migration confirmation only. Leave unset on the long-running API service.
# DATABASE_PREFLIGHT_APPLY=CREATE_INDEXES

# DynamoDB (migration in progress, see docs/DYNAMODB_MIGRATION_PLAN.md).
# Unset means every collection stays on MongoDB. Every collection has a
# DynamoDB implementation: app_settings, report_delivery_runs, evaluations,
# the four job queues, and the six that share transactions (colleges, boas,
# users, password_resets, instructors, attendance), which switch together
# through DB_WRITE_TO_CORE / DB_READ_FROM_CORE.
# DB_WRITE_TO=mongo           # mongo | both | dynamo
# DB_READ_FROM=mongo          # mongo | dynamo
# DYNAMODB_REGION=ap-south-1
# Its own IAM user, limited to the facultytrack-* tables. Never the SES key.
# DYNAMODB_ACCESS_KEY_ID=
# DYNAMODB_SECRET_ACCESS_KEY=
# DYNAMODB_TABLE_PREFIX=facultytrack-
# Local development only: docker run -p 8001:8000 amazon/dynamodb-local
# DYNAMODB_ENDPOINT=http://localhost:8001

# Authentication. Use unique production values; never commit them.
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@nxtwave.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Increment this identifier whenever ADMIN_PASSWORD is intentionally rotated.
ADMIN_PASSWORD_VERSION=1

# Google sign-in (optional). Leave blank to hide the button entirely.
# Sign-in only: the address must already belong to an active user.
GOOGLE_CLIENT_ID=

# Gemini 2.5 Flash-Lite vision evaluation
GEMINI_API_KEY=
# Model, timeout, retry, lease, polling and concurrency values have safe code
# defaults. Add an override only when deliberately tuning a deployment.
# Explicit male/female prompt caching is enabled by default with a one-hour
# TTL. Set GEMINI_EXPLICIT_CACHE=false only to disable it during diagnosis.

# Cloudflare R2 private attendance-photo storage
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# How long one R2 request may take. Photo storage runs inside the check-in
# request and holds a decode slot while it does, so an unbounded wait on a
# silent R2 closes check-in without raising an error. Default 15000.
R2_TIMEOUT_MS=

# AWS SES (check-in and checkout reports)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials.
AWS_SESSION_TOKEN=
SES_FROM_EMAIL=
# Optional SES configuration set name.
SES_CONFIGURATION_SET=
# SES timeout/retry and notification lease/concurrency values use code defaults.

# AWS Rekognition (photo-first instructor identification)
# Create the collection once, then set its name here. While this is blank the
# face features report NOT_CONFIGURED and check-in keeps working unchanged.
REKOGNITION_COLLECTION_ID=
# Defaults to AWS_REGION when unset.
AWS_REKOGNITION_REGION=ap-south-1
# Below this similarity a check-in is saved unidentified for an admin to
# resolve, rather than filed against a guessed name.
REKOGNITION_MATCH_THRESHOLD=95
# Faces accumulate as admins correct mistakes; the oldest is dropped at the cap.
REKOGNITION_MAX_FACES_PER_INSTRUCTOR=6
# Search, quality-floor, timeout and retry values use code defaults.
